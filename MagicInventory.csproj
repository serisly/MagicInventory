<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">

  <PropertyGroup>
    <Version>0.0.1.0</Version>
    <Author>Seris</Author>
    <Name>Magic Inventory</Name>
    <InternalName>MagicInventory</InternalName>
    <Punchline>Personal inventory organizer and crafting mat tracker.</Punchline>
    <Description>Personal FFXIV plugin for cleaning up bags and retainers. Adds buttons to game windows for retainer sorting, vendor/GC selling, Market Board price review, and recipe material tracking. Right-click any item to pin your own rule.</Description>
    <RepoUrl>https://github.com/serisly/MagicInventory</RepoUrl>
    <IconUrl>https://raw.githubusercontent.com/serisly/MagicInventory/main/images/icon.png</IconUrl>
    <Tags>inventory;retainer;market;crafting;utility</Tags>
    <ApplicableVersion>any</ApplicableVersion>
    <DalamudApiLevel>15</DalamudApiLevel>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputPath>bin\x64\$(Configuration)\</OutputPath>
    <DefaultItemExcludes>$(DefaultItemExcludes);tests/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleTo">
      <_Parameter1>MagicInventory.Tests</_Parameter1>
    </AssemblyAttribute>
    <PackageReference Include="KamiToolKit" Version="2.2.66" />
    <None Include="images\icon.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
